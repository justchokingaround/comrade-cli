#!/bin/sh

version_number="6.0.1"

# UI

# shellcheck disable=SC2086
# $1 = prompt, $2 = multi select flag (for fzf/rofi), $3 = extra flags by user
menu() {
    case "$menu_program" in
        fzf) fzf --reverse --cycle --prompt "$1" $2 $3 ;;
        rofi) rofi -sort -dmenu -i -p "$1" $2 $3 ;;
        dmenu) dmenu -l 20 -p "$1" $3 ;;
        *) "$menu_program" $3 "$1" ;;
    esac
}

# provide menu. input format is either (ep_list) or (number \t id \t name)
nth() {
    _stdin=$(cat -)
    [ -z "$_stdin" ] && return 1
    _line_count="$(printf "%s\n" "$_stdin" | wc -l | tr -d "[:space:]")"
    [ "$_line_count" -eq 1 ] && printf "%s" "$_stdin" | cut -f 2,3 && return 0
    _prompt="$1"
    [ $# -ne 1 ] && _multi_flag="$2"
    _line=$(printf "%s" "$_stdin" | cut -f 1,3 | tr '\t' ' ' | menu "$_prompt" "$_multi_flag" "$menu_extra_flags" | cut -d " " -f 1)
    _line_start=$(printf "%s" "$_line" | head -n 1)
    _line_end=$(printf "%s" "$_line" | tail -n 1)
    [ -n "$_line" ] || return 1
    if [ "$_line_start" = "$_line_end" ]; then
        printf "%s" "$_stdin" | grep -E '^'"${_line}"'($|[[:space:]])' | cut -f 2,3 || return 1
    else
        printf "%s" "$_stdin" | sed -n '/^'"${_line_start}"'$/,/^'"${_line_end}$"'/p' || return 1
    fi
}

die() {
    printf "\33[2K\r\033[1;31m%s\033[0m\n" "$*" >&2
    exit 1
}

info() {
    printf "\33[2K\r\033[1;34m%s\033[0m\n" "$*"
}

help_info() {
    printf "
    Usage:
    %s [options] [query]
    %s [query] [options]
    %s [options] [query] [options]

    Options:
      -c, --continue
        Continue watching from history
      -d, --download
        Download the video instead of playing it
      -D, --delete
        Delete history
      -l, --logview
        Show logs
      -s, --syncplay
        Use Syncplay to watch with friends
      -S, --select-nth
        Select nth entry
      -q, --quality
        Specify the video quality
      -v, --vlc
        Use VLC to play the video
      -V, --version
        Show the version of the script
      -h, --help
        Show this help message and exit
      -e, --episode, -r, --range
        Specify the number of episodes to watch
      --rofi
        Use rofi instead of fzf for the interactive menu
      --dmenu
        Use dmenu instead of fzf for the interactive menu
      --no-detach
        Don't detach the player (useful for in-terminal playback, mpv only)
      --exit-after-play
        Exit the player, and return the player exit code (useful for non interactive scenarios)
      -U, --update
        Update the script
    Some example usages:
      %s -q 720p spy x family
      %s -S 2 one piece
      %s -d -e 2 one piece
      %s --vlc one piece -q 1080p -e 4
      %s blue lock -e 5-6
      %s -e \"5 6\" blue lock
    \n" "${0##*/}" "${0##*/}" "${0##*/}" "${0##*/}" "${0##*/}" "${0##*/}" "${0##*/}" "${0##*/}" "${0##*/}"
    exit 0
}

version_info() {
    printf "%s\n" "$version_number"
    exit 0
}

# Bookkeeping

update_script() {
    info "[branch:$branch] Checking for Update.."
    update="$(curl --fail-with-body -sL -A "$agent" "https://raw.githubusercontent.com/justchokingaround/comrade-cli/$branch/comrade-cli")" || die "[branch:$branch] Connection error: $update"
    new_version="$(printf "%s" "$update" | sed -nE 's|^version_number="([^"]+)"$|\1|p')"
    [ -z "$new_version" ] && die "[branch:$branch] Invalid response."
    printf "%s" "$update" | grep -q "^version_number" || die "[branch:$branch] Invalid response."
    update="$(printf "%s\n" "$update" | diff -u "$0" -)"
    if [ -z "$update" ]; then
        info "[branch:$branch] Script is up to date :) ($version_number)"
    else
        if printf "%s\n" "$update" | patch "$0" -; then
            info "[branch:$branch] Updated: $version_number -> $new_version"
        else
            die "[branch:$branch] Failed to update. Read the above line!"
        fi
    fi
    exit 0
}

# checks if dependencies are present
dep_ch() {
    command -v "$1" >/dev/null || die "Program $1 not found. Please install it."
}

# checks for deps in order and returns the first available. format is "prog_a,prog_b,prog_c"
dep_ch_failover() {
    [ -z "$1" ] && return 1
    prog=$(printf "%s" "$1" | cut -d "," -f 1)
    rest=$(printf "%s" "$1" | cut -s -d "," -f 2-)
    command -v "$prog" >/dev/null 2>&1 && printf "%s" "$prog" && return 0
    [ -e "$prog" ] && printf "%s" "$prog" && return 0
    dep_ch_failover "$rest"
}

cleanup() {
    tput sgr0 # clears colors
    rm -f "${histfile}.new" "$cookie_jar"
}

# SCRAPING (hdrezka.website)

# shellcheck disable=SC2086
hdrezka_curl() {
    curl -sL -A "$agent" --compressed --max-time 15 -b "$cookie_jar" -c "$cookie_jar" "$@"
}

hdrezka_blockcheck() {
    printf "%s" "$1" | grep -qi 'anubis_challenge\|Just a moment\|Проверяем, что вы не бот' && die "Blocked by hdrezka's anti-bot check. Try again in a bit."
    return 0
}

# search the query and give results. format is (id_path \t "title [year] (type)")
hdrezka_search() {
    #shellcheck disable=SC2059
    _page="$(hdrezka_curl "$(printf "$search_api" "$1")")"
    hdrezka_blockcheck "$_page"
    printf "%s" "$_page" | tr '\n' ' ' | sed 's|<div class="b-content__inline_item"|\n<div class="b-content__inline_item"|g' |
        sed -nE 's@^<div class="b-content__inline_item" data-id="[0-9]+" data-url="https://hdrezka\.website/([^"]+)\.html".*<i class="entity">([^<]*)</i>.*<a href="[^"]*">([^<]*)</a> <div>([0-9]{4})[^<]*</div>.*@\1\t\3 [\4] (\2)@p' |
        sed -e "s|&#039;|'|g" -e 's|&quot;|"|g' -e 's|&amp;|\&|g'
}

# fetches the anime page into $anime_page, derives $data_id and $is_movie (1 = single video, no episodes)
hdrezka_load_page() {
    anime_page="$(hdrezka_curl "${base_api}/${1}.html")"
    hdrezka_blockcheck "$anime_page"
    [ -z "$anime_page" ] && die "Could not load anime page!"
    data_id="$(printf "%s" "$1" | sed -nE 's@.*/([0-9]+)-.*@\1@p')"
    if printf "%s" "$anime_page" | grep -q 'data-episode_id='; then is_movie=0; else is_movie=1; fi
}

# translation studios available for the loaded anime. format is (id \t name)
# films sneak an extra data-id="..." attribute in before data-translator_id, series don't
# hdrezka renders the translator picker twice (desktop + mobile variants), so the same
# data-translator_id shows up more than once and sometimes with an empty title on one of
# the two; dedupe by id, keeping the first non-empty name and dropping ids that never get one
hdrezka_translators() {
    printf "%s" "$anime_page" | tr '\n' ' ' | grep -oE 'title="[^"]*" class="b-translator__item[^"]*"[^>]*data-translator_id="[0-9]+"' |
        sed -E 's@title="([^"]*)" class="b-translator__item( active)?"[^>]*data-translator_id="([0-9]+)"@\3\t\1@' |
        awk -F'\t' '!seen[$1]++ { order[++n] = $1 } $2 != "" && !(name[$1]) { name[$1] = $2 } END { for (i = 1; i <= n; i++) { id = order[i]; if (name[id] != "") print id "\t" name[id] } }'
}

# the id of the translation studio marked as default on the page
# when there's only one translator, hdrezka omits the b-translator__item list entirely,
# so fall back to the id embedded in the initCDN(Series|Movies)Events(...) call
hdrezka_default_translator() {
    _t="$(printf "%s" "$anime_page" | tr '\n' ' ' | grep -oE 'title="[^"]*" class="b-translator__item active"[^>]*data-translator_id="[0-9]+"' |
        sed -E 's@.*data-translator_id="([0-9]+)"@\1@' | head -n 1)"
    [ -z "$_t" ] && _t="$(printf "%s" "$anime_page" | tr '\n' ' ' | sed -nE 's@.*initCDN(Series|Movies)Events\([0-9]+, ([0-9]+),.*@\2@p' | head -n 1)"
    printf "%s" "$_t"
}

# seasons embedded in the loaded anime page. format is (id \t name)
hdrezka_seasons() {
    printf "%s" "$anime_page" | tr '\n' ' ' | grep -oE 'data-tab_id="[0-9]+"[^>]*>[^<]*' | sed -E 's@data-tab_id="([0-9]+)"[^>]*>@\1\t@'
}

# episode numbers for the given season id ($1)
hdrezka_episodes() {
    printf "%s" "$anime_page" | tr '\n' ' ' | grep -oE 'data-season_id="'"$1"'" data-episode_id="[0-9]+"' | sed -E 's@.*data-episode_id="([0-9]+)"@\1@'
}

# fetches stream links + subtitle for $1 = episode number (ignored for movies). sets $links and $sub_link
hdrezka_stream() {
    if [ "$is_movie" = 1 ]; then
        _data="$(hdrezka_curl -X POST "${base_api}/ajax/get_cdn_series/" --data-raw "id=${data_id}&translator_id=${translator_id}&action=get_movie")"
    else
        _data="$(hdrezka_curl -X POST "${base_api}/ajax/get_cdn_series/" --data-raw "id=${data_id}&translator_id=${translator_id}&season=${season_id}&episode=${1}&action=get_stream")"
    fi
    printf "%s" "$_data" | grep -q '"success":true' || die "No sources found for this translation!"
    _urlfield="$(printf "%s" "$_data" | sed -nE 's@.*"url":"([^"]*)".*@\1@p' | sed 's|\\/|/|g')"
    links="$(printf "%s" "$_urlfield" | tr ',' '\n' | sed -nE 's@\[([0-9]+p)\].* or (.*)@\1 >\2@p' | sort -g -r -s)"
    sub_link="$(printf "%s" "$_data" | sed -nE 's@.*"subtitle":"([^"]*)".*@\1@p' | sed -e 's|\\/|/|g' -e 's@^\[[^]]*\]@@' -e 's@,.*@@')"
}

# select the quality according to the setting
select_quality() {
    case "$1" in
        best) _result=$(printf "%s" "$links" | head -n 1) ;;
        worst) _result=$(printf "%s" "$links" | grep -E '^[0-9]{3,4}' | tail -n 1) ;;
        *) _result=$(printf "%s" "$links" | grep -m 1 "$1") ;;
    esac
    [ -z "$_result" ] && printf "\33[2K\r\033[1;33m%s\033[0m\n" "$1 not found, defaulting to best" >&2 && _result=$(printf "%s" "$links" | head -n 1)

    video_link=$(printf "%s" "$_result" | cut -d ">" -f 2)
}

# gets stream links and selects one with desired quality into $video_link
get_video_link() {
    hdrezka_stream "$ep_no"
    [ -z "$links" ] && die "No sources found!"
    info "hdrezka.website links fetched"
    select_quality "$quality"
    [ -z "$video_link" ] && die "No valid sources!"
}

# HISTORY

backup_old_hist() {
    backupfile="${histfile}.v5"
    while IFS="	" read -r ep_no anime_id anime_title; do
        case "$anime_id" in
            */*-*) printf "%s\t%s\t%s\n" "$ep_no" "$anime_id" "$anime_title" >>"${histfile}.new" ;;
            *) printf "%s\t%s\t%s\n" "$ep_no" "$anime_id" "$anime_title" >>"$backupfile" ;;
        esac
    done <"$histfile"
    mv "${histfile}.new" "$histfile"
}

# $hist_id is "path/to/anime-id" optionally followed by "#season_id"
process_hist_entry() {
    anime_id="${hist_id%%#*}"
    case "$hist_id" in
        *#*) season_id="${hist_id#*#}" ;;
        *) season_id="" ;;
    esac
    hdrezka_load_page "$anime_id" 2>/dev/null || return
    if [ "$is_movie" = 1 ]; then
        ep_list="1"
    else
        ep_list="$(hdrezka_episodes "$season_id")"
    fi
    _next_ep=$(printf "%s" "$ep_list" | sed -n "/^${ep_no}$/{n;p;}") 2>/dev/null
    [ -n "$_next_ep" ] && printf "%s\t%s - episode %s\n" "$hist_id" "$anime_title" "$_next_ep"
}

update_history() {
    if grep -q "	${hist_id}	" "$histfile"; then
        # escape sed special chars in replacement: & and \ and delimiter |
        safe_title=$(printf "%s" "$anime_title" | sed 's|[&\|]|\\&|g')
        sed -E "s|^[^	]+	${hist_id}	[^	]+$|${ep_no}	${hist_id}	${safe_title}|" "$histfile" >"${histfile}.new"
    else
        cp "$histfile" "${histfile}.new"
        printf "%s\t%s\t%s\n" "$ep_no" "$hist_id" "$anime_title" >>"${histfile}.new"
    fi
    mv "${histfile}.new" "$histfile"
}

# PLAYING

# shellcheck disable=SC2086
# $1 = video link, $2 = video name, $3 = extra flags
download() {
    command -v "yt-dlp" >/dev/null && yt-dlp "$1" --no-skip-unavailable-fragments --fragment-retries infinite -N 16 -o "$download_dir/$2.mp4" $3 && return 0
    ffmpeg -extension_picky 0 -loglevel error -stats -i "$1" -c copy "$download_dir/$2.mp4" $3
}

play_episode() {
    [ "$log_episode" = 1 ] && [ "$player_function" != "debug" ] && [ "$player_function" != "download" ] && command -v logger >/dev/null && logger -t comrade-cli "${anime_title} ${ep_no}"
    [ -z "$video_link" ] && get_video_link
    # wait for the previous player to close (in range selection)
    wait
    sub_flag=""
    [ -n "$sub_link" ] && sub_flag="--sub-file=$sub_link"
    # shellcheck disable=SC2086
    case "$player_function" in
        debug) printf "All links:\n%s\nSelected link:\n%s\nSubtitle:\n%s\n" "$links" "$video_link" "$sub_link" ;;
        android_mpv) nohup am start --user 0 -a android.intent.action.VIEW -d "$video_link" -n is.xyz.mpv/.MPVActivity -e "title" "${anime_title} Episode ${ep_no}" $player_extra_flags >/dev/null 2>&1 & ;;
        android_vlc) nohup am start --user 0 -a android.intent.action.VIEW -d "$video_link" -n org.videolan.vlc/org.videolan.vlc.gui.video.VideoPlayerActivity -e "title" "${anime_title} Episode ${ep_no}" $player_extra_flags >/dev/null 2>&1 & ;;
        *flatpak*mpv*) flatpak run io.mpv.Mpv $sub_flag $player_extra_flags --force-media-title="${anime_title} Episode ${ep_no}" "$video_link" >/dev/null 2>&1 & ;;
        *mpv*)
            if [ "$no_detach" = 0 ]; then
                nohup $player_function $sub_flag $player_extra_flags --force-media-title="${anime_title} Episode ${ep_no}" "$video_link" >/dev/null 2>&1 &
            else
                $player_function $sub_flag $player_extra_flags --force-media-title="${anime_title} Episode ${ep_no}" "$video_link"
                mpv_exitcode=$?
                [ "$exit_after_play" = 1 ] && [ -z "$_range" ] && exit "$mpv_exitcode"
            fi
            ;;
        *iina*)
            if pgrep -f "IINA" >/dev/null 2>&1; then
                # omit --keep-running when an IINA instance exists to prevent hanging
                nohup $player_function $player_extra_flags --no-stdin --mpv-force-media-title="${anime_title} Episode ${ep_no}" "$video_link" >/dev/null 2>&1 &
            else
                nohup $player_function $player_extra_flags --no-stdin --keep-running --mpv-force-media-title="${anime_title} Episode ${ep_no}" "$video_link" >/dev/null 2>&1 &
            fi
            ;;
        *vlc*) nohup $player_function $player_extra_flags --play-and-exit --meta-title="${anime_title} Episode ${ep_no}" "$video_link" >/dev/null 2>&1 & ;;
        *yncpla*) nohup $player_function $player_extra_flags "$video_link" -- --force-media-title="${anime_title} Episode ${ep_no}" >/dev/null 2>&1 & ;;
        download) "$player_function" "$video_link" "${anime_title} Episode ${ep_no}" $player_extra_flags ;;
        catt) nohup catt cast $player_extra_flags "$video_link" >/dev/null 2>&1 & ;;
        iSH)
            printf "\033]8;;vlc://%s\a~~~~~~~~~~~~~~~~~~~~\n~ Tap to open VLC ~\n~~~~~~~~~~~~~~~~~~~~\033]8;;\a\n" "$video_link"
            sleep 5
            ;;
        *) nohup $player_function $player_extra_flags "$video_link" >/dev/null 2>&1 & ;;
    esac
    replay="$video_link"
    unset video_link
    update_history
    [ "$menu_program" != "fzf" ] && wait
}

play() {
    _start=$(printf "%s" "$ep_no" | grep -Eo '^(-1|[0-9]+(\.[0-9]+)?)')
    _end=$(printf "%s" "$ep_no" | grep -Eo '(-1|[0-9]+(\.[0-9]+)?)$')
    [ "$_start" = "-1" ] && ep_no=$(printf "%s" "$ep_list" | tail -n 1) && unset _start
    [ -z "$_end" ] || [ "$_end" = "$_start" ] && unset _start _end
    [ "$_end" = "-1" ] && _end=$(printf "%s" "$ep_list" | tail -n 1)
    _line_count=$(printf "%s\n" "$ep_no" | wc -l | tr -d "[:space:]")
    if [ "$_line_count" != 1 ] || [ -n "$_start" ]; then
        [ -z "$_start" ] && _start=$(printf "%s\n" "$ep_no" | head -n 1)
        [ -z "$_end" ] && _end=$(printf "%s\n" "$ep_no" | tail -n 1)
        _range=$(printf "%s\n" "$ep_list" | sed -nE "/^${_start}\$/,/^${_end}\$/p")
        [ -z "$_range" ] && die "Invalid range!"
        for i in $_range; do
            tput clear
            ep_no=$i
            info "Playing episode $ep_no..."
            [ "$i" = "$_end" ] && unset _range
            play_episode
        done
    else
        printf "%s" "$ep_list" | grep -q "^$ep_no$" || die "Invalid episode!"
        play_episode
    fi
    # moves up to stored position and deletes to end
    [ "$player_function" != "debug" ] && [ "$player_function" != "download" ] && tput rc && tput ed
}

# MAIN

# setup
base_api="https://hdrezka.website"
search_api="${base_api}/search/?do=search&subaction=search&q=%s"
agent="uwu"

download_dir="${COMRADE_CLI_DOWNLOAD_DIR:-.}"
log_episode="${COMRADE_CLI_LOG:-1}"
quality="${COMRADE_CLI_QUALITY:-best}"

dep_ch "curl"

case "$(uname -a | cut -d " " -f 1,3-)" in
    *Darwin*) player_function="${COMRADE_CLI_PLAYER:-$(dep_ch_failover "iina,/Applications/IINA.app/Contents/MacOS/iina-cli,mpv,vlc")}" || die 'No player found. Looked for iina, mpv and vlc' ;; # mac OS
    *ndroid*) player_function="${COMRADE_CLI_PLAYER:-android_mpv}" ;;                                                                                                                                        # Android OS (termux)
    *MINGW* | *WSL2*) player_function="${COMRADE_CLI_PLAYER:-mpv.exe}" ;;                                                                                                                                    # Windows OS
    *ish*) player_function="${COMRADE_CLI_PLAYER:-iSH}" ;;                                                                                                                                                   # iOS (iSH)
    *) player_function="${COMRADE_CLI_PLAYER:-$(dep_ch_failover "mpv,$HOME/.local/share/flatpak/app/io.mpv.Mpv/,/var/lib/flatpak/app/io.mpv.Mpv/,vlc")}" || die 'No player found. Looked for mpv and vlc' ;; # Linux OS
esac

player_extra_flags="${COMRADE_CLI_PLAYER_FLAGS:-""}"
no_detach="${COMRADE_CLI_NO_DETACH:-0}"
exit_after_play="${COMRADE_CLI_EXIT_AFTER_PLAY:-0}"
menu_program="${COMRADE_CLI_MENU:-fzf}"
menu_extra_flags="${COMRADE_CLI_MENU_FLAGS:-""}"

# not opening from a terminal
if [ ! -t 0 ]; then
    command -v dmenu >/dev/null && menu_program=dmenu
    command -v rofi >/dev/null && menu_program=rofi
fi

hist_dir="${COMRADE_CLI_HIST_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/comrade-cli}"
[ ! -d "$hist_dir" ] && mkdir -p "$hist_dir"
histfile="$hist_dir/ani-hsts"
[ ! -f "$histfile" ] && : >"$histfile"
cookie_jar="$(mktemp)"

source="${COMRADE_CLI_DEFAULT_SOURCE:-search}"
branch="${COMRADE_CLI_BRANCH:-master}"

while [ $# -gt 0 ]; do
    case "$1" in
        -v | --vlc)
            case "$(uname -a | cut -d " " -f 1,3-)" in
                *ndroid*) player_function="android_vlc" ;;
                MINGW* | *WSL2*) player_function="vlc.exe" ;;
                *ish*) player_function="iSH" ;;
                *) player_function="vlc" ;;
            esac
            ;;
        -s | --syncplay)
            case "$(uname -s)" in
                Darwin*) player_function="/Applications/Syncplay.app/Contents/MacOS/syncplay" ;;
                MINGW* | *Msys)
                    export PATH="$PATH":"/c/Program Files (x86)/Syncplay/"
                    player_function="syncplay.exe"
                    ;;
                *) player_function="syncplay" ;;
            esac
            ;;
        -q | --quality)
            [ $# -lt 2 ] && die "missing argument!"
            quality="$2"
            shift
            ;;
        -S | --select-nth)
            [ $# -lt 2 ] && die "missing argument!"
            index="$2"
            shift
            ;;
        -c | --continue) source=history ;;
        -d | --download)
            player_function=download
            ;;
        -D | --delete)
            : >"$histfile"
            exit 0
            ;;
        -l | --logview)
            case "$(uname -s)" in
                Darwin*) log show --predicate 'process == "logger"' ;;
                Linux*) journalctl -t comrade-cli ;;
                *) die "Logger not implemented for your platform" ;;
            esac
            exit 0
            ;;
        -V | --version) version_info ;;
        -h | --help) help_info ;;
        -e | --episode | -r | --range)
            [ $# -lt 2 ] && die "missing argument!"
            ep_no="$2"
            shift
            ;;
        --no-detach) no_detach=1 ;;
        --exit-after-play) exit_after_play=1 && no_detach=1 ;;
        --rofi) menu_program=rofi ;;
        --dmenu) menu_program=dmenu ;;
        -U | --update)
            dep_ch "patch"
            branch="${2:-$branch}"
            update_script
            ;;
        *) query="$(printf "%s" "$query $1" | sed 's|^ ||;s| |+|g')" ;;
    esac
    shift
done

[ "$menu_program" = "fzf" ] && menu_multi_flag="-m"
[ "$menu_program" = "rofi" ] && menu_multi_flag="-multi-select"

info "Checking dependencies..."
dep_ch "sed"
dep_ch "grep"
dep_ch "$menu_program" # TODO: use dep_ch_failover to iterate through options

case "$player_function" in
    debug) ;;
    download) dep_ch_failover "yt-dlp,ffmpeg" >/dev/null || die 'Neither yt-dlp nor ffmpeg found' ;;
    android*) printf "\33[2K\rChecking of players on Android is disabled.\n" ;;
    *iSH*) printf "\33[2K\rChecking of players on iOS is disabled\n" ;;
    *flatpak*mpv*) dep_ch "flatpak" ;;
    *) dep_ch "$player_function" ;;
esac

# idk where to put this, so I put it here...
trap 'cleanup; exit 1' INT HUP TERM

# searching
case "$source" in
    history)
        backup_old_hist
        anime_list=$(while read -r ep_no hist_id anime_title; do process_hist_entry & done <"$histfile")
        wait
        [ -z "$anime_list" ] && die "No unwatched series in history!"
        [ -z "${index##*[!0-9]*}" ] && hist_id=$(printf "%s" "$anime_list" | nl -w 2 | sed 's/^[[:space:]]//' | nth "Select anime: " | cut -f 1)
        [ -z "${index##*[!0-9]*}" ] || hist_id=$(printf "%s" "$anime_list" | sed -n "${index}p" | cut -f 1)
        [ -z "$hist_id" ] && exit 1
        anime_title=$(printf "%s" "$anime_list" | grep "^$hist_id	" | cut -f 2 | sed 's| - episode.*||')
        anime_id="${hist_id%%#*}"
        case "$hist_id" in
            *#*) season_id="${hist_id#*#}" ;;
            *) season_id="" ;;
        esac
        hdrezka_load_page "$anime_id"
        if [ "$is_movie" = 1 ]; then
            ep_list="1"
        else
            ep_list="$(hdrezka_episodes "$season_id")"
        fi
        translator_id="$(hdrezka_default_translator)"
        ep_no=$(printf "%s" "$anime_list" | grep "^$hist_id	" | sed -nE 's/.*- episode (.+)$/\1/p')
        ;;
    *)
        if [ "$menu_program" = "fzf" ]; then
            while [ -z "$query" ]; do
                printf "\33[2K\r\033[1;36mSearch: \033[0m" && read -r query
            done
        else
            [ -z "$query" ] && query=$(: | menu "Search: " "" "$menu_extra_flags")
            [ -z "$query" ] && exit 1
        fi

        query=$(printf "%s" "$query" | sed 's| |+|g')

        anime_list=$(hdrezka_search "$query")
        [ -z "$anime_list" ] && die "No results found!"
        [ "$index" -eq "$index" ] 2>/dev/null && result=$(printf "%s" "$anime_list" | sed -n "${index}p")
        [ -z "$index" ] && result=$(printf "%s" "$anime_list" | nl -w 2 | sed 's/^[[:space:]]//' | nth "Select: ")
        [ -z "$result" ] && die "Invalid selection"
        anime_title="$(printf "%s" "$result" | cut -f 2)"
        anime_id="$(printf "%s" "$result" | cut -f 1)"
        hdrezka_load_page "$anime_id"
        if [ "$is_movie" = 1 ]; then
            ep_list="1"
            season_id=""
            hist_id="$anime_id"
        else
            seasons="$(hdrezka_seasons)"
            if [ "$(printf "%s\n" "$seasons" | wc -l | tr -d "[:space:]")" -gt 1 ]; then
                season_id=$(printf "%s" "$seasons" | nl -w 2 | sed 's/^[[:space:]]//' | nth "Select season: " | cut -f 1)
                [ -z "$season_id" ] && die "Invalid season selection"
            else
                season_id=$(printf "%s" "$seasons" | cut -f 1)
                # hdrezka omits season tabs for single-season titles but still tags
                # episodes with data-season_id="0" in the markup, so default to that
                [ -z "$season_id" ] && season_id=0
            fi
            hist_id="${anime_id}#${season_id}"
            ep_list="$(hdrezka_episodes "$season_id")"
        fi
        translators="$(hdrezka_translators)"
        if [ -z "$translators" ]; then
            translator_id="$(hdrezka_default_translator)"
        else
            translator_id=$(printf "%s" "$translators" | nl -w 2 | sed 's/^[[:space:]]//' | nth "Select translation: " | cut -f 1)
            [ -z "$translator_id" ] && die "Invalid translation selection"
        fi
        [ -z "$ep_no" ] && ep_no=$(printf "%s" "$ep_list" | nth "Select episode: " "$menu_multi_flag")
        [ -z "$ep_no" ] && die "Invalid episode selection"
        ;;
esac

# moves the cursor up one line and clears that line
tput cuu1 && tput el
# stores the position of cursor
tput sc

# playback & loop
play
[ "$player_function" = "download" ] || [ "$player_function" = "debug" ] && exit 0

seasons_option=""
[ "$is_movie" = 0 ] && [ "$(printf "%s\n" "$seasons" | wc -l | tr -d "[:space:]")" -gt 1 ] && seasons_option="\nchange_season"
translator_option=""
[ "$(printf "%s\n" "$translators" | wc -l | tr -d "[:space:]")" -gt 1 ] && translator_option="\nchange_translator"

#shellcheck disable=SC2059
while cmd=$(printf "next\nreplay\nprevious\nselect${seasons_option}${translator_option}\nchange_quality\nquit" | nth "Playing episode $ep_no of $anime_title... "); do
    case "$cmd" in
        next) ep_no=$(printf "%s" "$ep_list" | sed -n "/^${ep_no}$/{n;p;}") 2>/dev/null ;;
        replay) video_link="$replay" ;;
        previous) ep_no=$(printf "%s" "$ep_list" | sed -n "/^${ep_no}$/{g;1!p;};h") 2>/dev/null ;;
        select) ep_no=$(printf "%s" "$ep_list" | nth "Select episode: " "$menu_multi_flag") ;;
        change_season)
            new_season="$(printf "%s" "$seasons" | nl -w 2 | sed 's/^[[:space:]]//' | nth "Select season: ")"
            [ -z "$new_season" ] && die "Invalid season selection"
            season_id="$(printf "%s" "$new_season" | cut -f 1)"
            hist_id="${anime_id}#${season_id}"
            ep_list="$(hdrezka_episodes "$season_id")"
            ep_no=$(printf "%s" "$ep_list" | nth "Select episode: " "$menu_multi_flag")
            [ -z "$ep_no" ] && die "Invalid episode selection"
            ;;
        change_translator)
            new_translator="$(printf "%s" "$translators" | nl -w 2 | sed 's/^[[:space:]]//' | nth "Select translation: ")"
            [ -z "$new_translator" ] && die "Invalid translation selection"
            translator_id="$(printf "%s" "$new_translator" | cut -f 1)"
            ;;
        change_quality)
            new_quality="$(printf "%s" "$links" | menu "Select Quality: " "" "$menu_extra_flags" | cut -d ">" -f 1)"
            [ -z "$new_quality" ] && die "No quality selected"
            select_quality "$new_quality"
            ;;
        *)
            cleanup
            exit 0
            ;;
    esac
    [ -z "$ep_no" ] && die "Out of range"
    play
done

